{
  "name": "@aiy/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first AI image generation and asset management workbench",
  "author": "AIY Image Tools",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gantrol/aiy-desktop.git"
  },
  "homepage": "https://github.com/gantrol/aiy-desktop#readme",
  "bugs": {
    "url": "https://github.com/gantrol/aiy-desktop/issues"
  },
  "productName": "AIY Image Tools",
  "main": "out/main/index.js",
  "scripts": {
    "electron:install": "install-electron --no",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev --watch",
    "prestart": "npm run electron:install",
    "start": "electron-vite dev --watch",
    "build": "electron-vite build",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepreview": "npm run electron:install",
    "preview": "electron-vite preview",
    "prepackage": "npm run electron:install",
    "package": "npm run verify && npm run build && electron-builder --dir",
    "premake": "npm run electron:install",
    "make": "npm run verify && npm run build && electron-builder --win",
    "premake:mac": "npm run electron:install",
    "make:mac": "npm run verify && npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "lint:design": "vitest run --config vitest.architecture.config.ts tests/design-system-contract.architecture.test.ts",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:architecture": "vitest run --config vitest.architecture.config.ts",
    "test:all": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "fixtures:images": "node scripts/generate-image-fixtures.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@annotorious/react": "3.8.8",
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "better-sqlite3": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.26.0",
    "openseadragon": "6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron@43.3.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller": false
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}

{
  "name": "@aiy/desktop",
  "version": "0.5.10",
  "private": true,
  "description": "AI × DIY: a local-first creative workspace where you create and AI helps",
  "author": "AIY",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/gantrol/aiy-desktop.git"
  },
  "homepage": "https://github.com/gantrol/aiy-desktop#readme",
  "bin": {
    "aiy-agent": "bin/aiy-agent.cjs"
  },
  "bugs": {
    "url": "https://github.com/gantrol/aiy-desktop/issues"
  },
  "productName": "AIY",
  "main": "out/main/index.js",
  "scripts": {
    "electron:install": "node node_modules/electron/install.js --no && node scripts/prepare-macos.mjs",
    "predev": "npm run electron:install",
    "dev": "node scripts/run-electron-vite-dev.mjs",
    "install:browser": "npm --prefix browser-companion ci --no-audit --no-fund",
    "dev:browser": "npm --prefix browser-companion run dev",
    "build:browser": "npm --prefix browser-companion run build",
    "typecheck:browser": "npm --prefix browser-companion run typecheck",
    "dev:deep-link": "npm run electron:install && node scripts/run-electron-vite-dev.mjs --deep-link",
    "deep-link:register": "npm run electron:install && node scripts/manage-dev-deep-link.mjs register",
    "deep-link:unregister": "npm run electron:install && node scripts/manage-dev-deep-link.mjs unregister",
    "prestart": "npm run electron:install",
    "start": "node scripts/run-electron-vite-dev.mjs",
    "prebuild": "node scripts/prepare-macos.mjs",
    "build": "electron-vite build",
    "aiy:agent": "node out/main/agent-cli.js",
    "build:unpacked": "npm run electron:install && npm run build && electron-builder --win dir --x64",
    "lint": "eslint . --cache --cache-location .tmp/eslint/ --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location .tmp/eslint/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:touched": "node scripts/verify-touched-files.mjs",
    "prepreview": "node node_modules/electron/install.js --no && node scripts/prepare-macos.mjs",
    "preview": "node scripts/run-electron-vite-preview.mjs",
    "package": "npm run release:store",
    "make": "npm run release:store",
    "make:mac": "npm run electron:install && npm run build && electron-builder --config electron-builder.mac.cjs --mac --publish never",
    "make:store": "npm run electron:install && npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-msix.ps1",
    "release:store": "npm run verify:store && npm run make:store",
    "make:store:local": "npm run electron:install && npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-msix.ps1 -LocalTest",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:smoke",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "verify:codex-pricing": "node scripts/verify-codex-usage-pricing.mjs",
    "verify:test-boundary": "node scripts/verify-public-smoke-boundary.mjs",
    "verify:store": "npm run verify:codex-pricing && npm run format:check && npm run lint && npm run typecheck && npm run verify:test-boundary && npm run test:smoke && npm run build",
    "verify": "npm run verify:codex-pricing && npm run format:check && npm run lint && npm run typecheck && npm run verify:test-boundary && npm run test:smoke && npm run build",
    "design:dev": "node scripts/design-lab.mjs dev",
    "design:build": "node scripts/design-lab.mjs build",
    "design:storybook": "storybook dev --config-dir design-lab/storybook --host 127.0.0.1 --port 6006 --ci --no-open --disable-telemetry",
    "design:storybook:build": "storybook build --config-dir design-lab/storybook --output-dir .tmp/storybook --disable-telemetry"
  },
  "dependencies": {
    "@annotorious/react": "3.8.8",
    "@huggingface/transformers": "4.3.1",
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-details": "3.30.5",
    "@tiptap/extension-find-and-replace": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-mathematics": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-task-item": "3.30.5",
    "@tiptap/extension-task-list": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "better-sqlite3": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "dompurify": "3.4.16",
    "epubjs": "0.3.93",
    "gifenc": "1.0.3",
    "html-to-image": "1.11.13",
    "jsonc-parser": "3.3.1",
    "jsqr": "1.4.0",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "lucide-react": "1.26.0",
    "marked": "17.0.6",
    "mediabunny": "^1.53.0",
    "mermaid": "11.17.2",
    "omggif": "1.0.10",
    "onnxruntime-node": "1.30.0",
    "openseadragon": "6.0.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "prosemirror-collab": "1.3.1",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "^11.0.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "tailwind-merge": "3.6.0",
    "twitter-text": "3.1.0",
    "ulid": "3.0.2",
    "unified": "^11.0.5",
    "use-sync-external-store": "1.6.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@microsoft/winappcli": "0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/twitter-text": "3.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.7.4",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.27.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^27.4.0",
    "magic-string": "0.30.21",
    "prettier": "^3.9.6",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@microsoft/winappcli@0.6.0": true,
    "better-sqlite3@13.0.1": true,
    "electron@43.7.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    },
    "js-yaml": "4.3.1"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  }
}

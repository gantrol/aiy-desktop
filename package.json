{
  "name": "@aiy/desktop",
  "version": "0.3.3",
  "private": true,
  "description": "Local-first AI image generation and asset management workbench",
  "author": "AIY Image Tools",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gantrol/aiy-desktop.git"
  },
  "homepage": "https://github.com/gantrol/aiy-desktop#readme",
  "bugs": {
    "url": "https://github.com/gantrol/aiy-desktop/issues"
  },
  "productName": "AIY Image Tools",
  "main": "out/main/index.js",
  "scripts": {
    "electron:install": "install-electron --no",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev --watch",
    "prestart": "npm run electron:install",
    "start": "electron-vite dev --watch",
    "build": "electron-vite build",
    "lint": "eslint . --cache --cache-location .tmp/eslint/ --max-warnings 0 --suppressions-location eslint-suppressions.json",
    "lint:fix": "eslint . --cache --cache-location .tmp/eslint/ --fix --suppressions-location eslint-suppressions.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepreview": "npm run electron:install",
    "preview": "electron-vite preview",
    "prepackage": "npm run electron:install",
    "package": "npm run verify && npm run build && electron-builder --dir",
    "premake": "npm run electron:install",
    "make": "npm run verify && npm run build && electron-builder --win --publish never",
    "premake:store": "npm run electron:install",
    "make:store": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-msix.ps1",
    "release:store": "npm run verify:store && npm run make:store",
    "premake:store:local": "npm run electron:install",
    "make:store:local": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-store-msix.ps1 -LocalTest",
    "premake:mac": "npm run electron:install",
    "make:mac": "npm run verify && npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:smoke",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "verify:test-boundary": "node scripts/verify-public-smoke-boundary.mjs",
    "verify:store": "npm run lint && npm run typecheck && npm run verify:test-boundary && npm run test:smoke",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run verify:test-boundary && npm run test:smoke"
  },
  "dependencies": {
    "@annotorious/react": "3.8.8",
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "better-sqlite3": "13.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "electron-updater": "6.8.9",
    "html-to-image": "1.11.13",
    "js-yaml": "4.3.1",
    "lucide-react": "1.26.0",
    "mediabunny": "^1.53.0",
    "openseadragon": "6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "3.6.0",
    "ulid": "3.0.2",
    "unified": "^11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/winappcli": "0.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron@43.3.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller": false
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  }
}

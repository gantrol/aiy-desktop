{
  "name": "@aiy/browser-companion",
  "version": "0.0.5",
  "private": true,
  "description": "A local browser companion that automatically fills AIY handoffs without sending or publishing them.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "build": "wxt build -b chrome",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"

    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "twitter-text": "3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/twitter-text": "3.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wxt": "0.21.4"
  }

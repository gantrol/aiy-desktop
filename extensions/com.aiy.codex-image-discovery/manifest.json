{
  "manifestVersion": 1,
  "kind": "CAPABILITY",
  "id": "com.aiy.codex-image-discovery",
  "version": "0.3.1",
  "displayName": "Codex Image Discovery",
  "description": "Discover images generated by local Codex tasks and import selected results as external creations.",
  "engines": {
    "aiy": "^0.3.0"
  },
  "runtime": {
    "kind": "HOST",
    "id": "codex-image-discovery"
  },
  "contributes": {
    "commands": ["codexImages.refresh"],
    "workflows": ["codexImages.importGenerated"],
    "searchProviders": ["codex.generatedImages"]
  },
  "permissions": ["filesystem.read:codex-generated-images", "library.write:creations"],
  "optionalPermissions": [],
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "displayName": "Codex Image Discovery",
        "description": "Discover images generated by local Codex tasks and import selected results as external creations."
      },
      "zh": {
        "displayName": "Codex 图片发现",
        "description": "发现本机 Codex 任务生成的图片，并把选中的结果导入为外部创作。"
      }
    }
  }
}

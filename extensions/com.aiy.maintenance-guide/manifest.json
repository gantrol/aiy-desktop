{
  "manifestVersion": 1,
  "kind": "CAPABILITY",
  "id": "com.aiy.maintenance-guide",
  "version": "0.1.0",
  "displayName": "Project Commands",
  "description": "Project configuration and reference documents.",
  "engines": { "aiy": "^0.3.0" },
  "runtime": { "kind": "HOST", "id": "maintenance-guide" },
  "contributes": { "commands": ["maintenanceGuide.open"] },
  "permissions": ["filesystem.read:maintenance-guides"],
  "optionalPermissions": ["filesystem.read:project-command-configs"],
  "i18n": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "displayName": "Project Commands",
        "description": "Project configuration and reference documents."
      },
      "zh": { "displayName": "项目命令", "description": "项目配置与参考资料。" }
    }
  }
}

      "localizations": [
        {
          "locale": "en",
          "name": "WeChat Article Header",
          "description": "A clean, modern WeChat article header composed for both a 2.35:1 banner and a complete 1:1 secondary-story crop."
        }
      ],
      "parameters": [],
      "promptNodes": [
        {
          "kind": "TEXT",
          "promptFragment": "clean, modern and visually polished WeChat Official Account article header image, 2.35:1 wide aspect ratio, bright or neutral editorial color palette, clear visual hierarchy, restrained contemporary composition, generous negative space for headline typography, composition remains effective in both primary and secondary article-card displays, include one self-contained square-safe region with a complete focal subject and sufficient contextual background so it can be cropped into a coherent 1:1 secondary-story thumbnail, keep essential content away from the outer edges",
          "negativeFragment": "night-mode blue-purple palette, blue-purple gradient aesthetic, neon cyberpunk lighting, cluttered layout, weak hierarchy, tiny unreadable text, key content at the extreme edges, fragmented or cropped focal subject in the square-safe region, watermark"
        }
      ]
    },

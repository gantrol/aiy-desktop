                  {
                    "type": "text",
                    "text": " → "
                  },
                  {
                    "type": "text",
                    "text": "验收要求",
                    "marks": [
                      {
                        "type": "link",
                        "attrs": {
                          "href": "#aiy-block:dev-acceptance"

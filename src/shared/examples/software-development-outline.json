          "blockId": "dev-confirmation",
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "确认 · 保留取舍，不伪造批准"
          }
        ]
      },
      {
        "type": "bulletList",
        "attrs": {
          "blockId": "dev-decisions"
        },
        "content": [
          {
            "type": "listItem",
            "attrs": {
              "blockId": "dev-decision"
